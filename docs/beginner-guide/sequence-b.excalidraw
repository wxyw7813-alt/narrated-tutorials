-29", "type": "text", "x": 65, "y": 797, "width": 1290, "height": 65.0, "angle": 0, "strokeColor": "#735020", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 29, "version": 1, "versionNonce": 29, "isDeleted": false, "boundElements": null, "updated": 1795650000000, "link": null, "locked": false, "text": "声线分支：在线预设需已同意发送旁白；本地中文／Heart 需相应模型。本人声音需授权录音、准确转录和运行中的\n克隆引擎，真实模型效果仍待验证。内置试听不需先装模型。", "originalText": "声线分支：在线预设需已同意发送旁白；本地中文／Heart 需相应模型。本人声音需授权录音、准确转录和运行中的克隆引擎，真实模型效果仍待验证。内置试听不需先装模型。", "fontSize": 25, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.3}, {"id": "sequence-b-30", "type": "arrow", "x": 530, "y": 950, "width": 760, "height": 0, "angle": 0, "strokeColor": "#315de8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 30, "version": 1, "versionNonce": 30, "isDeleted": false, "boundElements": null, "updated": 1795650000000, "link": null, "locked": false, "points": [[0, 0], [760, 0]], "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "sequence-b-31", "type": "text", "x": 554, "y": 892, "width": 712, "height": 36.4, "angle": 0, "strokeColor": "#17243a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 31, "version": 1, "versionNonce": 31, "isDeleted": false, "boundElements": null, "updated": 1795650000000, "link": null, "locked": false, "text": "准备讲稿、分镜、模板或流程图", "originalText": "准备讲稿、分镜、模板或流程图", "fontSize": 28, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.3}, {"id": "sequence-b-32", "type": "arrow", "x": 530, "y